---
import type { ContentPayload } from '../../graphql/shared/ContentPayload';
import ArticlePageCard from '../pages/ArticlePage/ArticlePageCard.astro';
import ArticleList from './ArticleListComponent/ArticleList.astro';
import Button from './ButtonComponent/Button.astro';
import DamAssetList from './DamAssetListComponent/DamAssetList.astro';
import CallToAction from './CallToActionComponent/CallToAction.astro';
import Card from './CardComponent/Card.astro';
import Carousel from './CarouselComponent/Carousel.astro';
import Collapse from './CollapseComponent/Collapse.astro';
import Divider from './DividerComponent/Divider.astro';
import FacetedSearch from './FacetedSearchComponent/FacetedSearch.astro';
import Grid from './GridComponent/Grid.astro';
import Hero from './HeroComponent/Hero.astro';
import Iframe from './IframeComponent/Iframe.astro';
import Image from './ImageComponent/Image.astro';
import OdpForm from './OdpFormComponent/OdpForm.astro';
import Paragraph from './ParagraphComponent/Paragraph.astro';
import Text from './TextComponent/Text.astro';
import Video from './VideoComponent/Video.astro';
import VideoExternal from './VideoExternalComponent/VideoExternal.astro';
import OptiForm from '../forms/base/OptiFormsContainerDataComponent/OptiForm.astro';

interface Props {
    contentPayload: ContentPayload;
    data: any;
}

const { contentPayload, data } = Astro.props as Props;
const { component, displaySettings, displayTemplateKey } = data;

// Access gate: Graph inlines referenced blocks into page/experience responses
// without evaluating per-item read access, so the top-level fetchers resolve
// the set of readable keys (see src/lib/content-access.ts). A shared block
// whose key is not in that set must not render. Inline Visual Builder
// elements have `_metadata.key: null` — they belong to the already-authorized
// parent experience, so they always render.
const allowedKeys = Astro.locals?.allowedContentKeys;
const enforceAccess = contentPayload?.ctx === 'view' && allowedKeys != null;
const componentKey: string | null | undefined = component?._metadata?.key;
const isBlocked = enforceAccess && !!componentKey && !allowedKeys.has(componentKey);
if (isBlocked && import.meta.env.DEV) {
    console.warn(
        `[content-access] Skipping component ${componentKey} — not readable by current user`
    );
}

const componentType = isBlocked ? null : component._metadata.types[0];
---

{
    componentType === 'Text' && (
        <Text
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'CallToAction' && (
        <CallToAction
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displayTemplateKey={displayTemplateKey}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Image' && (
        <Image
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Video' && (
        <Video
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Paragraph' && (
        <Paragraph
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Card' && (
        <Card
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'Hero' && (
        <Hero
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Carousel' && (
        <Carousel
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'Collapse' && (
        <Collapse
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'ArticleList' && (
        <ArticleList
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}
{
    componentType === 'Grid' && (
        <Grid
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'Button' && (
        <Button
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}

{
    componentType === 'Iframe' && (
        <Iframe
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}
{
    componentType === 'VideoExternal' && (
        <VideoExternal
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}

{
    componentType === 'ArticlePage' && (
        <ArticlePageCard
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
        />
    )
}

{
    componentType === 'Divider' && (
        <Divider
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}

{
    componentType === 'OdpForm' && (
        <OdpForm
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}

{
    componentType === 'FacetedSearch' && (
        <FacetedSearch
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
        />
    )
}

{
    componentType === 'DamAssetList' && (
        <DamAssetList
            key={data?.key}
            contentPayload={contentPayload}
            data={component}
            displaySettings={displaySettings}
            displayTemplateKey={displayTemplateKey}
        />
    )
}

{
    componentType === 'OptiFormsContainerData' && (
        <OptiForm contentPayload={contentPayload} grid={component} />
    )
}
