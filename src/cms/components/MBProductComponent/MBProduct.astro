---
import type {
    MbProductFragment,
    DisplaySettingsFragment,
} from '../../../../__generated/sdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import { getOptimizelySdk } from '../../../graphql/getSdk';
import { isEditContext } from '../../shared/utils.ts';
import { getDictionaryFromDisplaySettings } from '../../../graphql/shared/displaySettingsHelpers.ts';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    key: string;
    data: MbProductFragment;
    displaySettings: DisplaySettingsFragment[];
    displayTemplateKey: string;
    contentPayload: ContentPayload;
}

const { key, data, displaySettings, contentPayload } = Astro.props as Props;

const settings = getDictionaryFromDisplaySettings(displaySettings);
const isCompact = (settings['layout'] ?? 'compact') === 'compact';

const experienceKey = data.Product?.key ?? null;
const pageUrl = data.Product?.url?.default ?? '#';

let product: any = null;
if (experienceKey) {
    const response = await getOptimizelySdk(contentPayload).getMBExperienceProduct({
        key: experienceKey,
    });
    product = response?.MBExperienceProductPage?.items?.[0]?.Product?.item ?? null;
}
---

<span data-epi-block-id={isCmsEdit && key || undefined} class="component-mb-product flex flex-col flex-1">
    {product ? (
        <a href={pageUrl} class="flex flex-col flex-1 card bg-base-100 border border-base-300 hover:shadow-md transition-shadow duration-200 no-underline">
            <figure class={`overflow-hidden bg-gray-50 ${isCompact ? 'h-32' : 'h-44'}`}>
                {product.image_url ? (
                    <img src={product.image_url} alt={product.organism_name} class="h-full w-full object-contain p-3" />
                ) : (
                    <div class="h-full w-full flex items-center justify-center text-base-content/20">
                        <svg class="w-12 h-12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                    </div>
                )}
            </figure>
            <div class={`card-body flex-1 ${isCompact ? 'p-4' : 'p-5'}`}>
                <div class="flex items-start gap-2 mb-1">
                    {product.taxonomy && (
                        <span class="badge badge-outline badge-xs shrink-0 mt-0.5">{product.taxonomy}</span>
                    )}
                    {product.product_format && (
                        <span class="badge badge-ghost badge-xs shrink-0 mt-0.5">{product.product_format}</span>
                    )}
                </div>
                <h3 class={`card-title text-base-content leading-snug ${isCompact ? 'text-sm' : 'text-base'}`}>
                    {product.organism_name}
                </h3>
                {product.atcc_designation && (
                    <p class="text-xs text-base-content/50 font-mono -mt-1">{product.atcc_designation}</p>
                )}
                {!isCompact && product.description && (
                    <p class="text-sm text-base-content/60 mt-1 line-clamp-2">{product.description}</p>
                )}
                <div class="card-actions justify-between items-center mt-3">
                    <span class="text-xs text-base-content/40 font-mono">{product.item_number}</span>
                    {product.price != null && (
                        <span class="font-semibold text-base-content text-sm">
                            {product.currency ?? 'USD'} {Number(product.price).toFixed(2)}
                        </span>
                    )}
                </div>
            </div>
        </a>
    ) : (
        <div class="card bg-base-200 border border-base-300">
            <div class="card-body p-4">
                <p class="text-base-content/40 text-sm">No product selected</p>
            </div>
        </div>
    )}
</span>
