---
import type { MbExperienceProductPage, Locales } from '../../../../__generated/sdk';
import { getOptimizelySdk } from '../../../graphql/getSdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import Layout from '../../../layouts/Layout.astro';
import Section from '../../compositions/Section/Section.astro';

const previewPayload = Astro.props.data as ContentPayload;

const optiResponse = await getOptimizelySdk(previewPayload).getExperience({
    key: previewPayload.key,
    ver: previewPayload.ver,
    loc: previewPayload.loc as Locales,
});

const experience = optiResponse?._Experience?.item;
if (!experience) throw new Error('No experience found');

const page = experience as MbExperienceProductPage;

const metaTitle = page.ExperienceSeoSettings?.MetaTitle || experience._metadata?.displayName || '';
const metaDescription = page.ExperienceSeoSettings?.MetaDescription || '';
const metaIndexing = page.ExperienceSeoSettings?.Indexing || false;
const metaGraphType = page.ExperienceSeoSettings?.GraphType || 'website';
const extPreviewEnabled = page.PageAdminSettings?.EnableExternalPreview ?? false;

const defaultUrl = experience._metadata?.url?.default || '';
const hierarchicalUrl =
    experience._metadata?.url?.type === 'SIMPLE'
        ? experience._metadata?.url?.hierarchical
        : '';

const product = (page as any).Product?.item;
const productDetailedDescription = (page as any).ProductDetailedDescription?.html;

let variants: any[] = [];
if (product?.organism_name) {
    const variantsResponse = await getOptimizelySdk(previewPayload).getMBProductVariants({
        organismName: product.organism_name,
    });
    variants = (variantsResponse?.ProductMBOCP?.items ?? []).filter(Boolean);
}

variants.sort((a, b) => (a.product_format || '').localeCompare(b.product_format || ''));

if (variants.length === 0 && product) {
    variants = [product];
}

const variantsJson = JSON.stringify(variants);
const initialFormat = product?.product_format || '';
---

<Layout
    title={metaTitle}
    description={metaDescription}
    indexing={metaIndexing}
    graphtype={metaGraphType}
    contentPayload={previewPayload}
    defaultUrl={defaultUrl}
    hierarchicalUrl={hierarchicalUrl ?? ''}
    extPreviewEnabled={extPreviewEnabled}
>
    {product && (
        <>
            <script is:inline>
                function mbProduct() {
                    return {
                        variants: [],
                        selectedFormat: '',

                        get activeVariant() {
                            var sel = this.selectedFormat;
                            return this.variants.find(function(v) { return v.product_format === sel; }) || this.variants[0];
                        },

                        price: function(p) {
                            if (p == null) return '';
                            var n = +p;
                            return '$' + (n % 1 === 0 ? n : n.toFixed(2));
                        },

                        splitList: function(str) {
                            if (!str) return [];
                            return str.split(';').map(function(s) { return s.trim(); }).filter(Boolean);
                        },

                        init: function() {
                            var el = this.$el;
                            this.variants = JSON.parse(el.dataset.variants || '[]');
                            var format = el.dataset.format || '';
                            var seed = this.variants.find(function(v) { return v.product_format === format; }) || this.variants[0];
                            if (seed) this.selectedFormat = seed.product_format || '';
                        }
                    };
                }
            </script>

            <div
                x-data="mbProduct()"
                data-variants={variantsJson}
                data-format={initialFormat}
            >
                <!-- Hero -->
                <div class="bg-[#1a5276] text-white">
                    <div class="max-w-7xl mx-auto px-6 py-10">
                        <div class="flex flex-col lg:flex-row gap-10">

                            <!-- Left: product info -->
                            <div class="flex-1 min-w-0">
                                <div class="mb-4">
                                    <span class="inline-block border border-white/40 text-white text-xs font-semibold px-3 py-1 rounded-full" x-text="activeVariant?.taxonomy || ''"></span>
                                </div>

                                <h1 class="text-3xl lg:text-4xl font-extrabold leading-tight mb-2 italic">
                                    {product.organism_name}
                                </h1>

                                {product.atcc_designation && (
                                    <p class="text-lg text-white/80 font-mono mb-6">{product.atcc_designation}</p>
                                )}

                                <p class="text-base text-white/70 mb-6">
                                    <span x-text="activeVariant?.product_format || ''"></span>
                                    {' · '}
                                    <span class="font-mono" x-text="activeVariant?.item_number || ''"></span>
                                </p>

                                <div class="flex flex-wrap gap-2">
                                    <template x-for="ind in splitList(activeVariant?.industry)" :key="ind">
                                        <span class="text-xs bg-white/10 border border-white/20 text-white/90 px-2.5 py-1 rounded-full" x-text="ind"></span>
                                    </template>
                                </div>
                            </div>

                            <!-- Right: image + purchase widget -->
                            <div class="lg:w-80 xl:w-96 flex-shrink-0">
                                <div class="bg-white rounded-xl p-4 mb-4 flex items-center justify-center h-48">
                                    <img
                                        x-bind:src="activeVariant?.image_url || ''"
                                        x-bind:alt="activeVariant?.product_name || ''"
                                        class="max-h-full max-w-full object-contain"
                                    />
                                </div>

                                <div class="bg-white text-gray-900 rounded-xl shadow-2xl p-5">
                                    {variants.length > 1 && (
                                        <div class="mb-4">
                                            <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Format</label>
                                            <div class="relative">
                                                <select
                                                    class="w-full border border-gray-300 rounded px-3 py-2.5 pr-9 text-sm appearance-none bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"
                                                    x-model="selectedFormat"
                                                >
                                                    <template x-for="v in variants" :key="v.product_format">
                                                        <option :value="v.product_format" x-text="v.product_format"></option>
                                                    </template>
                                                </select>
                                                <div class="pointer-events-none absolute inset-y-0 right-2 flex items-center text-gray-400">
                                                    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor">
                                                        <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                                                    </svg>
                                                </div>
                                            </div>
                                        </div>
                                    )}

                                    <div class="grid grid-cols-2 gap-3 mb-4 text-xs text-gray-600">
                                        <div>
                                            <p class="font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Quantity</p>
                                            <p class="font-medium text-gray-800" x-text="activeVariant?.quantity_per_kit || '—'"></p>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Storage</p>
                                            <p class="font-medium text-gray-800" x-text="activeVariant?.storage_temperature || '—'"></p>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Shelf Life</p>
                                            <p class="font-medium text-gray-800" x-text="activeVariant?.shelf_life_months ? activeVariant.shelf_life_months + ' months' : '—'"></p>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-400 uppercase tracking-wide mb-0.5">Item #</p>
                                            <p class="font-medium text-gray-800 font-mono" x-text="activeVariant?.item_number || '—'"></p>
                                        </div>
                                    </div>

                                    <div class="mb-4 border-t border-gray-100 pt-4">
                                        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide">Price</p>
                                        <p class="text-2xl font-bold text-gray-900" x-text="price(activeVariant?.price)"></p>
                                    </div>

                                    <button class="w-full bg-[#1a5276] hover:bg-[#154360] text-white font-semibold py-3 px-4 rounded-lg text-sm transition-colors">
                                        Add to Cart
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Product details -->
                <div class="bg-white py-10 border-b border-gray-100">
                    <div class="max-w-7xl mx-auto px-6">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                            <div>
                                <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Test Methods</h3>
                                <ul class="space-y-1">
                                    <template x-for="m in splitList(activeVariant?.test_method)" :key="m">
                                        <li class="text-sm text-gray-700 flex items-start gap-2">
                                            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#1a5276] shrink-0"></span>
                                            <span x-text="m"></span>
                                        </li>
                                    </template>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Standards &amp; Guidelines</h3>
                                <ul class="space-y-1">
                                    <template x-for="s in splitList(activeVariant?.standards_guidelines)" :key="s">
                                        <li class="text-sm text-gray-700 flex items-start gap-2">
                                            <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-[#1a5276] shrink-0"></span>
                                            <span x-text="s"></span>
                                        </li>
                                    </template>
                                </ul>
                            </div>
                            <div>
                                <h3 class="text-xs font-semibold text-gray-400 uppercase tracking-wide mb-3">Description</h3>
                                <p class="text-sm text-gray-700" x-text="activeVariant?.description || ''"></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Format variants table -->
                {variants.length > 1 && (
                    <div class="bg-gray-50 py-10 border-b border-gray-200">
                        <div class="max-w-7xl mx-auto px-6">
                            <h2 class="text-2xl font-bold text-gray-900 mb-6">Available Formats</h2>
                            <div class="overflow-x-auto">
                                <table class="w-full text-sm bg-white rounded-xl shadow-sm overflow-hidden">
                                    <thead>
                                        <tr class="border-b border-gray-200 bg-gray-50">
                                            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-5 py-3">Format</th>
                                            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-5 py-3">Item #</th>
                                            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-5 py-3">Quantity</th>
                                            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-5 py-3">Storage</th>
                                            <th class="text-left text-xs font-semibold text-gray-500 uppercase tracking-wide px-5 py-3">Price</th>
                                            <th class="px-5 py-3"></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <template x-for="(v, i) in variants" :key="i">
                                            <tr class="border-b border-gray-100 hover:bg-blue-50 transition-colors">
                                                <td class="px-5 py-4 font-semibold text-gray-900" x-text="v.product_format"></td>
                                                <td class="px-5 py-4 text-gray-500 font-mono text-xs" x-text="v.item_number"></td>
                                                <td class="px-5 py-4 text-gray-600" x-text="v.quantity_per_kit"></td>
                                                <td class="px-5 py-4 text-gray-600" x-text="v.storage_temperature"></td>
                                                <td class="px-5 py-4 font-semibold text-gray-900" x-text="price(v.price)"></td>
                                                <td class="px-5 py-4">
                                                    <button
                                                        @click="selectedFormat = v.product_format"
                                                        class="px-4 py-1.5 rounded text-xs font-semibold transition-colors"
                                                        :class="selectedFormat === v.product_format ? 'bg-[#1a5276] text-white' : 'border border-[#1a5276] text-[#1a5276] hover:bg-[#1a5276] hover:text-white'"
                                                    >
                                                        <span x-show="selectedFormat === v.product_format">&#10003; Selected</span>
                                                        <span x-show="selectedFormat !== v.product_format">Select</span>
                                                    </button>
                                                </td>
                                            </tr>
                                        </template>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </>
    )}

    {productDetailedDescription && (
        <div class="max-w-7xl mx-auto px-6 py-10">
            <div class="prose max-w-none" set:html={productDetailedDescription}></div>
        </div>
    )}

    <!-- Visual Builder content -->
    <div class="vb:outline relative w-full flex-1 page-experience">
        {experience?.composition?.grids?.map((grid: any) => (
            <Section contentPayload={previewPayload} grid={grid} />
        ))}
    </div>
</Layout>
