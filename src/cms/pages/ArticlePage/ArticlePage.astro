---
import { Image as AstroImage } from 'astro:assets';
import type { Locales } from 'astro';
import { format } from 'date-fns';
import type { ArticlePageFragment } from '../../../../__generated/sdk';
import { getOptimizelySdk } from '../../../graphql/getSdk';
import type { ContentPayload } from '../../../graphql/shared/ContentPayload';
import Layout from '../../../layouts/Layout.astro';
import ContentArea from '../../shared/ContentArea/ContentArea.astro';
import { isEditContext } from '../../shared/utils.ts';
import { resolveAllowedContentKeys } from '../../../lib/content-access';

const isCmsEdit = isEditContext(Astro.url);

export interface Props {
    contentPayload: ContentPayload;
}
const { contentPayload } = Astro.props as Props;

const optiResponse = await getOptimizelySdk(contentPayload, Astro.locals.user).pageById({
    key: contentPayload.key,
    //@ts-ignore
    loc: contentPayload.loc as Locales,
    ver: contentPayload.ver,
});
const post = optiResponse?._Page?.item as ArticlePageFragment;

// Gated content: anonymous visitors get only a teaser — everything up to the
// end of the first paragraph — so the rest of the body never leaves the server.
// CMS edit/preview context is never gated so editors can work on the full body.
const isGated =
    post?.GatedContent === true && !Astro.locals.user && !isCmsEdit;
const fullBodyHtml = post?.Body?.html ?? '';
const teaserEnd = fullBodyHtml.indexOf('</p>');
const bodyHtml = isGated
    ? teaserEnd === -1
        ? ''
        : fullBodyHtml.slice(0, teaserEnd + '</p>'.length)
    : fullBodyHtml;
const loginUrl = `/login?redirect=${encodeURIComponent(Astro.url.pathname)}`;

// Content area items are inlined by Graph without per-item access checks;
// resolve which embedded keys the current user may read so _Components.astro
// can skip the rest.
Astro.locals.allowedContentKeys = await resolveAllowedContentKeys(
    contentPayload,
    Astro.locals.user,
    isGated ? undefined : post?.BottomContent
);
const publishedDate = format(
    new Date(post?._metadata?.published ?? Date.now()),
    'dd MMM yyyy'
);


const graphType = post?.SeoSettings?.GraphType && post?.SeoSettings?.GraphType !== "-" ? 
    post?.SeoSettings?.GraphType : 'article';
const defaultUrl = post?._metadata?.url?.default || '';
const hierarchicalUrl = post?._metadata?.url?.type === "SIMPLE" ? post?._metadata?.url?.hierarchical : '';
const extPreviewEnabled = post?.PageAdminSettings?.EnableExternalPreview ?? false;

const pageClass = 'page-article';
---

<Layout
    title={post.SeoSettings?.MetaTitle ?? post?.Heading ?? post?._metadata?.displayName ?? 'Article'}
    description={post.SeoSettings?.MetaDescription ?? post?.Heading ?? ''}
    graphtype={graphType}
    indexing={post.SeoSettings?.Indexing ?? false}
    contentPayload={contentPayload}
    defaultUrl={defaultUrl}
    hierarchicalUrl={hierarchicalUrl ?? ''}
    extPreviewEnabled={extPreviewEnabled}
>
    <div class={`max-w-screen-6xl mx-auto ${pageClass}`}>
        <main class="mt-10">
            <div class="mx-auto max-w-screen-xl px-4 2xl:px-0">
                <h1
                    class="text-3xl lg:text-4xl leading-tight font-semibold text-base-content mb-6"
                    data-epi-edit={isCmsEdit ? "Heading" : undefined}
                >
                    {post?.Heading}
                </h1>
            </div>

            { ((post.PromoImage as any)?.item?.Url || post.PromoImage?.url?.default) &&
                <div class="mx-auto mb-8 w-full max-w-screen-xl">
                    <AstroImage
                        src={(post.PromoImage as any)?.item?.Url || post.PromoImage?.url?.default}
                        class="w-full h-auto max-h-[32rem] object-cover rounded-2xl"
                        alt={(post.PromoImage as any)?.item?.AltText || (post.PromoImage as any)?.item?._metadata?.displayName || post.Heading || 'Article promo image'}
                        inferSize={true}
                        data-epi-edit={isCmsEdit ? "PromoImage" : undefined}
                    />
                </div>
            }

            <div class="mx-auto max-w-screen-xl px-4 2xl:px-0 mb-8">
                <h2
                    class="text-xl lg:text-2xl leading-snug font-semibold text-base-content mb-4"
                    data-epi-edit={isCmsEdit ? "SubHeading" : undefined}
                >
                    {post?.SubHeading}
                </h2>
                <div class="flex items-center gap-3 border-t border-base-300 pt-4">
                    <div>
                        <p class="text-sm font-semibold text-base-content/65"
                            data-epi-edit={isCmsEdit ? "Author" : undefined}
                        >
                            {post?.Author}
                        </p>
                        <p class="text-xs text-base-content/50"
                            data-epi-edit={isCmsEdit ? "publishedDate" : undefined}
                        >
                            {publishedDate}
                        </p>
                    </div>
                </div>
            </div>

            <div class={isGated ? 'relative' : undefined}>
                <article
                    class="prose dark:prose-invert md:prose-lg lg:prose-xl mx-auto mt-4 mb-12 max-w-screen-xl px-4 2xl:px-0 prose-img:rounded-[2rem] prose-img:p-4"
                    data-epi-edit={isCmsEdit ? "Body" : undefined}
                    set:html={bodyHtml}
                />
                { isGated && bodyHtml &&
                    <div
                        class="pointer-events-none absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-base-100 to-transparent"
                        aria-hidden="true"
                    ></div>
                }
            </div>
            { isGated &&
                <div class="mx-auto mb-16 max-w-screen-xl px-4 2xl:px-0">
                    <div class="mx-auto max-w-xl rounded-2xl border border-base-300 bg-base-200 p-8 text-center">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="1.5"
                            stroke="currentColor"
                            class="mx-auto mb-3 h-8 w-8 text-base-content/60"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                            />
                        </svg>
                        <p class="mb-1 text-lg font-semibold text-base-content">
                            Log in to view the full article
                        </p>
                        <p class="mb-4 text-sm text-base-content/60">
                            This article is available to signed-in members.
                        </p>
                        <a href={loginUrl} class="btn btn-primary">Log in</a>
                    </div>
                </div>
            }
        </main>
        <!--Bottom content area (withheld on gated articles for anonymous visitors)-->
        { !isGated && post?.BottomContentHeader &&
            <div class="mx-auto max-w-screen-xl px-4 2xl:px-0 mt-12 mb-4">
                <h2
                    class="text-2xl lg:text-3xl font-semibold text-base-content"
                    data-epi-edit={isCmsEdit ? "BottomContentHeader" : undefined}
                >
                    {post.BottomContentHeader}
                </h2>
            </div>
        }
        <div class="mx-auto max-w-screen-xl px-4 2xl:px-0 justify-center p-2 sm:p-3 md:p-4 flex gap-8 overflow-x-auto flex-wrap">
            {
                !isGated && post?.BottomContent?.map((contentAreaItem: any) => {
                    const types: string[] = contentAreaItem?._metadata?.types ?? [];
                    const isFullWidth = types.some(t => t === 'Text' || t === 'Paragraph');
                    return (
                        <div class={isFullWidth ? 'w-full' : undefined}>
                            <ContentArea
                                contentPayload={contentPayload}
                                contentAreaItem={contentAreaItem}
                            />
                        </div>
                    );
                })
            }
        </div>
    </div>
</Layout>